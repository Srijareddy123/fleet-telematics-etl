# Copy to .env. The values below are local demo defaults, not real credentials.

# PostgreSQL (warehouse database)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleet_dw
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_password

# MinIO (S3 compatible object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_RAW_BUCKET=etl-raw-data
MINIO_PROCESSED_BUCKET=etl-processed

# Host ports. Change them if something else on your machine uses these.
POSTGRES_HOST_PORT=5432
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
AIRFLOW_HOST_PORT=8080
API_HOST_PORT=8000

# Alerting (optional, the code for it is commented out in etl/monitoring/alerts.py)
# SLACK_WEBHOOK_URL=
